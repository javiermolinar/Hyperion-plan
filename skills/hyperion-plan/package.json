{
  "name": "hyperion-plan",
  "version": "1.5.0",
  "private": true,
  "description": "Shared Markdown-backed Hyperion plans for Codex and Pi",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "hyperion-plan": "dist/plan.cjs"
  },
  "pi": {
    "extensions": ["./dist/hyperion-plan-pi.js"],
    "skills": ["./"]
  },
  "scripts": {
    "build": "tsc --noEmit && node build/build.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser/run.cjs",
    "test:pi:runtime": "node --test --test-name-pattern='real Pi runtime' tests/pi-context.test.cjs",
    "test:pi:agents": "node --test tests/pi-subagents.test.cjs",
    "test:pi:terminal": "node tests/pi/terminal-smoke.cjs",
    "test:pi:workflow": "node tests/pi/terminal-workflow.cjs",
    "check": "npm run build && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "^0.25.0",
    "prettier": "3.6.2",
    "typebox": "1.3.27",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "entities": "^6.0.0",
    "proper-lockfile": "^4.1.2"
  }
}
