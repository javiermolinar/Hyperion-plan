{
  "name": "hyperion-plan",
  "version": "1.3.2",
  "private": true,
  "description": "Markdown-backed interactive plans and an on-demand local CLI",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "hyperion-plan": "dist/plan.cjs"
  },
  "scripts": {
    "build": "tsc --noEmit && node build/build.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser/run.cjs",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "^0.25.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "entities": "^6.0.0",
    "proper-lockfile": "^4.1.2"
  }
}
